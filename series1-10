N = int(input("N: "))
total_int = 0.0
for i in range(N):
    num = float(input(f"Число {i+1}: "))
    int_part = float(int(num)) # Целая часть как вещественное
    print(int_part, end=" ")
    total_int += int_part
print(f"\nСумма целых частей: {total_int}")


N = int(input("N: "))
total = 0.0
prod = 1.0
for i in range(N):
    num = float(input(f"Число {i+1}: "))
    total += num
    prod *= num
print(f"Сумма: {total}, Произведение: {prod}")


