N = int(input("N: "))
total_rounded = 0
for i in range(N):
    num = float(input(f"Число {i+1}: "))
    rounded = int(num + 0.5) if num >= 0 else int(num - 0.5)
    print(rounded, end=" ")
    total_rounded += rounded
print(f"\nСумма округленных: {total_rounded}")


N = int(input("N: "))
prod_frac = 1.0
for i in range(N):
    num = float(input(f"Число {i+1}: "))
    frac_part = num - int(num) # Дробная часть
    print(frac_part, end=" ")
    prod_frac *= frac_part
print(f"\nПроизведение дробных частей: {prod_frac}")
